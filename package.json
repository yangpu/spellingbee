{
  "name": "spellingbee",
  "version": "2.1.25",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/bump-version.js",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "deploy": "npm run build && rsync -avz --delete dist/ root@yangruoji.com:/root/spellingbee && ssh root@yangruoji.com \"docker restart yangruoji-nginx\" && node scripts/publish-version.js",
    "deploy:dry": "npm run build && rsync -avz --delete --dry-run dist/ root@yangruoji.com:/root/spellingbee/ && ssh root@yangruoji.com \"docker restart yangruoji-nginx\"",
    "preview": "vite preview",
    "convert-words": "node scripts/convert-excel.js",
    "generate-icons": "node scripts/generate-pwa-icons.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "fetch-retry": "^6.0.0",
    "peerjs": "^1.5.5",
    "pinia": "^4.1.0",
    "tdesign-vue-next": "^1.20.11",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.14",
    "xlsx": "^0.18.5"
  }
}
